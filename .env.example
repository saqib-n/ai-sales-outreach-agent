# LLM provider, pick one and fill in its key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# "<provider>:<model>", e.g. openai:gpt-5.5, anthropic:claude-opus-5-5 or google_genai:gemini-3.5-flash
LLM_MODEL=openai:gpt-5.5

# Name the drafted emails are signed with
SENDER_NAME=

# Optional, without this the agent falls back to data/company_notes.json
# for research instead of a live web search
TAVILY_API_KEY=

# Optional, only needed to actually send email with --send
# for Gmail: use an app password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
